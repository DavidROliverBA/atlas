{
  "name": "@atlas/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p functions",
    "test": "playwright test",
    "test:functions": "vitest run functions-test",
    "deploy": "vite build && wrangler pages deploy --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@atlas/ai": "workspace:^",
    "@atlas/core": "workspace:*",
    "@atlas/stencils": "workspace:^",
    "@atlas/storage-supabase": "workspace:^",
    "@supabase/supabase-js": "^2.45.0",
    "@xyflow/react": "^12.3.0",
    "elkjs": "^0.12.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.112.0"
  }
}
