{
  "name": "@atlas/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p functions",
    "test": "playwright test",
    "test:functions": "vitest run functions-test",
    "deploy": "vite build && wrangler pages deploy --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@atlas/ai": "workspace:^",
    "@atlas/core": "workspace:*",
    "@atlas/stencils": "workspace:^",
    "@atlas/storage-supabase": "workspace:^",
    "@supabase/supabase-js": "^2.117.2",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "framer-motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
